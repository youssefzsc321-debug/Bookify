@model RentlasDetailsVM

@{
    ViewData["Title"] = "Rental Details";

}

<div class="card card-xl-stretch mb-5 mb-xl-8 shadow-sm">
    <!-- Header -->
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1 text-gray-900">
                <i class="bi bi-journal-bookmark-fill me-2 text-primary fs-2"></i>Rental Copies Details
            </span>
            <span class="text-muted mt-1 fw-semibold fs-7">Overview of all book copies included in this rental transaction</span>
        </h3>
        @if (Model.CreatedOn == DateTime.Today)
        {
            <div id="RentalToolbar" class="card-toolbar">
                <a asp-controller="Rentals" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-light-primary fw-bold">
                    <i class="bi"></i> Edit
                </a>
            </div>
        }
        else if (Model.Copies.Any(c => !c.ReturnDate.HasValue))
        {
            <div id="RentalToolbar" class="card-toolbar">
                <a asp-controller="Rentals" asp-action="Return" asp-route-id="@Model.Id" class="btn btn-sm btn-light-primary fw-bold">
                    <i class="bi"></i> Return any book
                </a>
            </div>
        }

    </div>

    <!-- Body -->
    <div class="card-body py-3">

        @if (!Model.Copies.Any())
        {
            <!-- Alert Empty State -->
            <div class="alert bg-light-info border border-info border-dashed d-flex align-items-center p-5 my-5" id="Alert">
                <i class="bi bi-info-circle-fill fs-2hx text-info me-4"></i>
                <div class="d-flex flex-column">
                    <h5 class="mb-1 text-info fw-bold">No Book Copies Found</h5>
                    <span class="text-gray-700">There are no individual book copies associated with this rental record.</span>
                </div>
            </div>
        }
        else
        {
            <!-- Table Responsive Container -->
            <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4 retnal-table">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0 bg-light">
                            <th class="ps-4 min-w-180px rounded-start">Book & Copy</th>
                            <th class="min-w-140px">Rental Period (Start - End)</th>
                            <th class="min-w-120px">Rental Date</th>
                            <th class="min-w-120px">Return Date</th>
                            <th class="min-w-110px">Extended On</th>
                            <th class="min-w-100px">Status</th>
                            <th class="min-w-100px text-end rounded-end pe-4">Delay Days</th>

                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        @foreach (var item in Model.Copies)
                        {
                            bool isReturned = item.ReturnDate.HasValue;
                            bool isOverdue = !isReturned && item.EndDate < DateTime.Today;

                            <tr>
                                <!-- Book Thumbnail, Title, BookId & BookCopyId -->
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <!-- Thumbnail Container -->
                                        <div class="symbol symbol-50px me-3">
                                            @if (!string.IsNullOrEmpty(item.imageThumbnailUrl))
                                            {
                                                <img src="@item.imageThumbnailUrl" class="rounded" alt="@item.BookTitle" style="object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <span class="symbol-label bg-light-primary text-primary fw-bold fs-4">
                                                    <i class="bi bi-journal-bookmark-fill text-primary"></i>
                                                </span>
                                            }
                                        </div>

                                        <!-- Book Title, BookId & Copy ID -->
                                        <div class="d-flex flex-column">
                                            <a href="/Books/Details/@item.BookId" class="text-gray-800 text-hover-primary fw-bold fs-6 mb-1">
                                                @(item.BookTitle ?? "Untitled Book")
                                            </a>
                                            <div class="d-flex gap-2 align-items-center">
                                                <span class="badge badge-light-secondary text-gray-700 fs-8 fw-bold">Book ID: #@item.BookId</span>
                                                <span class="badge badge-light-info text-info fs-8 fw-bold">Copy ID: #@item.BookCopyId</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Rental Period: StartDate -> EndDate -->
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="text-gray-800 fs-7 fw-bold">
                                            <i class="bi bi-play-circle text-success me-1"></i> @item.StartDate.ToString("dd MMM yyyy")
                                        </span>
                                        <span class="text-gray-800 fs-7 fw-bold mt-1">
                                            <i class="bi bi-stop-circle text-danger me-1"></i> @item.EndDate.ToString("dd MMM yyyy")
                                        </span>
                                    </div>
                                </td>

                                <!-- Rental Date -->
                                <td>
                                    <span class="text-gray-800 fw-semibold fs-7">
                                        <i class="bi bi-calendar-event me-1 text-muted"></i>
                                        @item.RentalDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <!-- Return Date -->
                                <td>
                                    @if (isReturned)
                                    {
                                        <span class="text-gray-800 fw-semibold fs-7">
                                            <i class="bi bi-calendar-check me-1 text-success"></i>
                                            @item.ReturnDate?.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light-warning fw-bold fs-8">Not Returned</span>
                                    }
                                </td>

                                <!-- Extended On -->
                                <td>
                                    @if (item.ExtendedOn.HasValue)
                                    {
                                        <span class="badge badge-light-info fw-bold fs-8">
                                            <i class="bi bi-clock-history me-1 text-info"></i>
                                            @item.ExtendedOn?.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-7">-</span>
                                    }
                                </td>

                                <!-- Status Badge -->
                                <td>
                                    @if (isReturned)
                                    {
                                        <span class="badge badge-light-success fw-bold px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1 text-success"></i> Returned
                                        </span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="badge badge-light-danger fw-bold px-3 py-2">
                                            <i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i> Overdue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light-primary fw-bold px-3 py-2">
                                            <i class="bi bi-hourglass-split me-1 text-primary"></i> Active
                                        </span>
                                    }
                                </td>

                                <!-- Penalty Pay Badge -->
                                <td class="text-end pe-4">

                                    <span class="badge badge-light-danger fs-7 fw-bold">
                                        @item.DelayDays Days
                                    </span>

                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>