@model RentalFormVM
@{
    ViewData["Title"] = $"{(Model.Id > 0 ? "Edit" : "Add")} Rental ";
    
}



<!--begin::Card-->
<div class="card mb-7">
    <div class="card-header">
        <h3 class="card-title">@(Model.Id>0?"Edit":"Add") Rental</h3>
    </div>
    <partial name="_SearchForm" model="@new SearchFormVM()" />
   

    <div class="card mb-5 mb-xl-8">
        <!--begin::Header-->
        <div class="card-header border-0 pt-5">
            <h3 class="card-title align-items-start flex-column">
                <span class="card-label fw-bold text-dark">Books</span>
                <span class="text-muted mt-1 fw-semibold fs-7">You can add up to @(Model.AllowedRentals) book(s)</span>
            </h3>
        </div>
        <!--end::Header-->
        <!--begin::Body-->
        <div class="card-body pt-5">
            <form asp-action=@(Model.Id > 0 ? "Edit" : "Create") id="CopiesForm">
                <input type="hidden" asp-for="SubscriberId" />
                @if (Model.BookCopies.Any())
                {
                    foreach (var item in Model.BookCopies)
                    {
                        <partial name="_copyDetails" model="@item" />
                    }
                }
                <button type="submit" class="btn btn-primary d-none" id="SaveButton">
                    <span class="indicator-label">
                        Save
                    </span>
                    <span class="indicator-progress">
                        Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </form>
        </div>
        <!--end::Body-->
    </div>
</div>
<!--end::Card-->

@Html.AntiForgeryToken()


@section Scripts{
    <script>
        var maxAllowedRental = @Model.AllowedRentals;
        var isEdit =@(Model.Id>0?"true":"false");
    </script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/rentalFrom.js"></script>
}