@model Bookify.Web.Core.ViewModel.SubscriberDetailsVM

@{
    ViewData["Title"] = "Subscriber Details";

    var lastSubStatus = Model.subscriptions?.LastOrDefault()?.Status;
    var isActive = lastSubStatus == "Active";
    var isBlackListed = Model.BlacListed; 

    string membershipBgClass = isBlackListed ? "bg-danger" : (isActive ? "bg-primary" : "bg-warning");

    string membershipTextClass = (isActive || isBlackListed) ? "text-white" : "text-gray-900";
    string membershipSubTextClass = (isActive || isBlackListed) ? "text-white opacity-75" : "text-gray-700";

    string membershipStatusText = isBlackListed ? "Black Listed" : (isActive ? "Active" : "Not Active");
}
<!--begin::Header Alert-->
<div class="alert bg-light-primary d-flex flex-column flex-sm-row w-100 p-5 mb-10 border border-primary border-dashed align-items-center">
    <div class="symbol symbol-40px me-4 mb-5 mb-sm-0">
        <div class="symbol-label fs-2 fw-semibold text-primary">
            <i class="bi bi-people-fill fs-2"></i>
        </div>
    </div>
    <div class="d-flex flex-column pe-0 pe-sm-10">
        <h4 class="fw-bold text-primary mb-0">Subscriber Details</h4>
    </div>
    <div class="ms-sm-auto">
        <a asp-action="Edit" asp-controller="Subscripers" asp-route-id="@Model.key" class="btn btn-sm btn-primary">
            <i class="bi bi-pencil-square me-1"></i> Edit
        </a>
    </div>
</div>
<!--end::Header Alert-->

<div class="d-flex flex-column flex-xl-row">
    <!--begin::Sidebar-->
    <div class="flex-column flex-lg-row-auto w-100 w-xl-350px mb-10">
        <div class="card mb-5 mb-xl-8">
            <div class="card-body pt-15">
                <div class="d-flex flex-center flex-column mb-5">
                    <div class="symbol symbol-100px symbol-circle mb-7">
                        <a data-fslightbox="gallery"
                           href="@(string.IsNullOrEmpty(Model.ImageUrl) ? (string.IsNullOrEmpty(Model.imageThumbnailUrl) ? "/assets/images/avatar-blank.svg" : Model.imageThumbnailUrl) : Model.ImageUrl)"
                           class="d-block symbol-label rounded-circle overflow-hidden position-relative">
                            <img src="@(string.IsNullOrEmpty(Model.imageThumbnailUrl) ? "/assets/images/avatar-blank.svg" : Model.imageThumbnailUrl)"
                                 alt="subscriber avatar"
                                 class="w-100 h-100 object-fit-cover cursor-pointer" />
                        </a>
                    </div>

                    <a href="#" class="fs-3 text-gray-800 text-hover-primary fw-bold mb-1">
                        @(Model.FullName ?? "N/A")
                    </a>

                    <div class="fs-5 fw-semibold text-muted mb-6">
                        <i class="bi bi-envelope me-1 text-muted"></i>@(Model.Email ?? "No Email Provided")
                    </div>
                </div>

                <div class="separator separator-dashed my-3"></div>

                <div class="pb-5 fs-6">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="fw-bold fs-5 text-gray-800">
                            <i class="bi bi-person-lines-fill me-1 text-primary"></i> Details
                        </div>
                        <span id="SubscriberStatusBadge" class="badge @(isBlackListed ? "badge-light-danger" : (isActive ? "badge-light-primary" : "badge-light-warning"))">
                            @(isBlackListed ? "Black Listed" : (isActive ? "Active" : "Not Active"))
                        </span>
                    </div>

                    <div class="fw-bold mt-5 text-muted">
                        <i class="bi bi-hash me-1"></i> Subscriber ID
                    </div>
                    <div class="text-gray-600">#@ViewData["Id"]</div>

                    <div class="fw-bold mt-5 text-muted">
                        <i class="bi bi-card-heading me-1"></i> National ID
                    </div>
                    <div class="text-gray-600">@(Model.NationalId ?? "N/A")</div>

                    <div class="fw-bold mt-5 text-muted">
                        <i class="bi bi-telephone me-1"></i> Mobile Number
                    </div>
                    <div class="text-gray-600">@(Model.MobileNumber ?? "N/A")</div>

                    <div class="fw-bold mt-5 text-muted">
                        <i class="bi bi-calendar-event me-1"></i> Date of Birth
                    </div>
                    <div class="text-gray-600">
                        @(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "N/A")
                    </div>

                    <div class="fw-bold mt-5 text-muted">
                        <i class="bi bi-geo-alt me-1"></i> Governorate / Area
                    </div>
                    <div class="text-gray-600">
                        @(!string.IsNullOrEmpty(Model.Governrete) ? Model.Governrete : "N/A")
                        @(!string.IsNullOrEmpty(Model.Area) ? $" / {Model.Area}" : "")
                    </div>

                    <div class="fw-bold mt-5 text-muted">
                        <i class="bi bi-house-door me-1"></i> Address
                    </div>
                    <div class="text-gray-600">@(Model.Address ?? "N/A")</div>
                </div>
            </div>
        </div>
    </div>
    <!--end::Sidebar-->
    <!--begin::Content-->
    <div class="flex-lg-row-fluid ms-lg-15">
        <!--begin::Tabs-->
        <ul class="nav nav-custom nav-tabs nav-line-tabs nav-line-tabs-2x border-0 fs-4 fw-semibold mb-8">
            <li class="nav-item">
                <a class="nav-link text-active-primary pb-4 active" data-bs-toggle="tab" href="#kt_subscriber_overview">
                    <i class="bi bi-grid-1x2 me-2"></i> Overview
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-active-primary pb-4" data-bs-toggle="tab" href="#kt_subscriber_rentals">
                    <i class="bi bi-journal-bookmark me-2"></i> Rentals / Activity
                </a>
            </li>
        </ul>
        <!--end::Tabs-->
        <!--begin::Tab Content-->
        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="kt_subscriber_overview" role="tabpanel">

                <div class="row g-5 g-xl-8 mb-8">
                    <!--begin::Active Rentals Card-->
                    <div class="col-xl-6">
                        <div class="card bg-light-primary card-xl-stretch mb-xl-8">
                            <div class="card-body my-3">
                                <span class="card-title fw-bold text-primary fs-3 mb-3 d-block">
                                    <i class="bi bi-book me-2"></i> Active Rentals
                                </span>
                                <div class="py-1">
                                    <span class="text-dark fw-bold fs-2hx me-2">2</span>
                                    <span class="fw-semibold text-muted fs-7">Books currently rented</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::Active Rentals Card-->
                    <!--begin::Membership Status Card-->
                    <div class="col-xl-6">
                        <div class="card @membershipBgClass card-xl-stretch mb-xl-8">
                            <div class="card-body my-3">
                                <span class="card-title fw-bold @membershipTextClass fs-3 mb-3 d-block">
                                    <i class="bi bi-shield-check me-2"></i> Membership Status
                                </span>
                                <div class="py-1">
                                    <span class="@membershipTextClass fw-bold fs-2hx me-2">@membershipStatusText</span>

                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::Membership Status Card-->
                </div>

                <!--begin::Subscriptions History Card-->
                <div class="card card-xl-stretch mb-5 mb-xl-8">
                    <div class="card-header border-0 pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold fs-3 mb-1">
                                <i class="bi bi-clock-history me-1 text-primary"></i> Subscriptions History
                            </span>
                            <span class="text-muted mt-1 fw-semibold fs-7">Recent subscriber activity</span>
                        </h3>
                        @if (!isBlackListed)
                        {
                            <div class="card-toolbar">
                                <a href="javascript:;" class="btn btn-sm btn-light-primary js-reNew" data-key="@Model.key">
                                    <i class="bi bi-arrow-repeat fs-3 me-1"></i> Renew
                                </a>
                            </div>
                        }
                    </div>

                    <div class="card-body py-3">
                        <div class="table-responsive">
                            <table class="table align-middle gs-0 gy-4" id="SubscriptionsTable">
                                <thead>
                                    <tr class="fw-bold text-muted bg-light">
                                        <th class="ps-4 min-w-125px rounded-start">Start Date</th>
                                        <th class="min-w-125px">End Date</th>
                                        <th class="min-w-150px">Status</th>
                                        <th class="min-w-125px text-end rounded-end pe-4">Created On</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.subscriptions != null && Model.subscriptions.Any())
                                    {
                                        @foreach (var sub in Model.subscriptions)
                                        {
                                            <partial name="_SubscritpionRow" model="@sub" />
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!--end::Subscriptions History Card-->

            </div>
        </div>
        <!--end::Tab Content-->
    </div>
    <!--end::Content-->
</div>

@Html.AntiForgeryToken()

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Subscriptions.js" asp-append-version="true"></script>
}