@model BookCopyVM

<tr>
    <td>@Model.SerialNumber</td>
    <td>@Model.EditionNumber</td>
    <td>
        <span class="badge badge-light-@(Model.IsAvailableForRental ? "success" : "warning")">
            @(Model.IsAvailableForRental ? "Available" : "Not Available")
        </span>
    </td>
    <td>
        <span class="badge badge-light-@(Model.IsDeleted ? "danger" : "success") js-status">
            @(Model.IsDeleted ? "Deleted" : "Available")
        </span>
    </td>
    <td>
        @Model.CreatedOn.ToString("dd/MM/yyyy")
    </td>
    <td>
        <a asp-controller="Rentals" asp-action="GetCopyHistory" asp-route-id="@Model.Id"
           class="btn btn-sm btn-light-info btn-active-info d-inline-flex align-items-center gap-1 px-3 py-1">
            <i class="bi bi-clock-history fs-6"></i>
            <span>History</span>
        </a>
    </td>

    <td class="text-end">
        <div class="dropdown">
            <button type="button" class="btn btn-sm btn-light btn-active-light-primary btn-icon"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots fs-3"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end fw-semibold w-150px py-3">
                <div class="menu-item px-3">
                    <a href="javascript:;"
                       data-title="Edit Book Copy"
                       data-url="/BookCopies/Edit/@Model.Id"
                       data-update="true"
                       class="menu-link px-3 js-render-modal">
                        <span class="menu-icon"><i class="bi bi-pencil-square"></i></span>
                        Edit
                    </a>
                </div>
                <div class="menu-item px-3">
                    <a href="javascript:;" class="menu-link px-3 flex-stack js-toggle-status"
                       data-id="@Model.Id"
                       data-url="/BookCopies/ToggleStatus/@Model.Id">
                        Toggle Status
                    </a>
                </div>
            </div>
        </div>
    </td>
</tr>