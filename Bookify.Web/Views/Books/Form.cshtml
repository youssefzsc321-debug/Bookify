@model BookFormVM
@{
    ViewData["Title"] = (Model.Id > 0 ? "Edit " : "Add ") + "Book";
}

<div class="card shadow-sm">
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold fs-3 mb-1 text-primary">
                <i class="bi bi-book me-2 text-primary fs-3"></i> @(Model.Id > 0 ? "Edit " : "Add ") Book
            </span>
            <span class="text-muted mt-1 fw-semibold fs-7">Please fill in the details below to save the book</span>
        </h3>

        <div class="card-toolbar">
            @{
                if (Model.Id > 0)
                {
                    <a class="btn btn-sm btn-light-primary" asp-action="Details" asp-controller="Books" asp-route-id="@Model.Id">
                        <i class="bi bi-arrow-rigth"></i> Go to Details
                    </a>
                }
            }


        </div>
    </div>

    <div class="card-body p-9">
        <form asp-controller="Books" asp-action="@(Model.Id > 0 ? "Edit" : "Create")" method="post" enctype="multipart/form-data">

            @if (Model.Id > 0)
            {
                <input type="hidden" asp-for="Id" />
            }

            @* --- Metronic Image Input Section --- *@
            <div class="mb-10">
                <label class="form-label fs-6 fw-bold text-gray-700 d-block mb-3">Book Cover Image</label>

                <div class="image-input image-input-empty mb-3" data-kt-image-input="true" style="background-image:url(@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/Gemini_Generated_Image_mrv14jmrv14jmrv1.png" : Model.imageThumbnailUrl))">
                    <div class="image-input-wrapper w-125px h-200px"></div>
                    <label class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                           data-kt-image-input-action="change"
                           data-bs-dismiss="click">
                        <i class="bi bi-pencil-fill fs-7"></i>

                        <input type="file" asp-for="Image" accept=".png, .jpg, .jpeg" />
                        <input type="hidden" name="avatar_remove" />
                    </label>
                    <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                          data-kt-image-input-action="cancel"
                          data-bs-dismiss="click">
                        <i class="bi bi-x fs-2"></i>
                    </span>
                    <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                          data-kt-image-input-action="remove"
                          data-bs-dismiss="click">
                        <i class="bi bi-x fs-2"></i>
                    </span>
                </div>
                <div class="form-text text-muted mb-2">Allowed types: png, jpg, jpeg and cannot be more than 2MB.</div>
                <span asp-validation-for="Image" class="text-danger d-block"></span>
            </div>

            @* --- Row 1: Title and Publisher --- *@
            <div class="row g-9 mb-8">
                <div class="col-md-6 fv-row">
                    <label asp-for="Title" class="form-label fs-6 fw-bold text-gray-700 mb-2">Book Title</label>
                    <input type="text" asp-for="Title" class="form-control form-control-solid" placeholder="Enter book title" />
                    <span asp-validation-for="Title" class="text-danger d-block mt-1"></span>
                </div>

                <div class="col-md-6 fv-row">
                    <label asp-for="Publisher" class="form-label fs-6 fw-bold text-gray-700 mb-2">Publisher</label>
                    <input type="text" asp-for="Publisher" class="form-control form-control-solid" placeholder="Enter publisher name" />
                    <span asp-validation-for="Publisher" class="text-danger d-block mt-1"></span>
                </div>
            </div>

            @* --- Row 2: Author and Publishing Date --- *@
            <div class="row g-9 mb-8">
                <div class="col-md-6 fv-row">
                    <label asp-for="AuthorsId" class="form-label fs-6 fw-bold text-gray-700 mb-2">Author</label>
                    <select asp-for="AuthorsId" asp-items="Model.Authors" class="form-select form-control-solid js-select2" data-control="select2" data-placeholder="Select an author">
                        <option value="">Select Author...</option>
                    </select>
                    <span asp-validation-for="AuthorsId" class="text-danger d-block mt-1"></span>
                </div>

                <div class="col-md-6 fv-row">
                    <label asp-for="PublishingDate" class="form-label fs-6 fw-bold text-gray-700 mb-2">Publishing Date</label>
                    <input type="text" asp-for="PublishingDate" class="form-control form-control-solid js-datepicker" />
                    <span asp-validation-for="PublishingDate" class="text-danger d-block mt-1"></span>
                </div>
            </div>

            @* --- Row 3: Categories and Hall --- *@
            <div class="row g-9 mb-8">
                <div class="col-md-6 fv-row">
                    <label asp-for="SelectedCategories" class="form-label fs-6 fw-bold text-gray-700 mb-2">Categories</label>
                    <select asp-for="SelectedCategories" asp-items="Model.Categories" class="form-select form-control-solid js-select2" data-control="select2" data-placeholder="Select categories" multiple="multiple">
                    </select>
                    <span asp-validation-for="SelectedCategories" class="text-danger d-block mt-1"></span>
                </div>

                <div class="col-md-6 fv-row">
                    <label asp-for="Hall" class="form-label fs-6 fw-bold text-gray-700 mb-2">Hall</label>
                    <input type="text" asp-for="Hall" class="form-control form-control-solid" placeholder="Enter hall number/name" />
                    <span asp-validation-for="Hall" class="text-danger d-block mt-1"></span>
                </div>
            </div>

            @* --- Row 4: Rental Status --- *@
            <div class="row g-9 mb-8">
                <div class="col-md-6 fv-row d-flex align-items-center">
                    <div class="form-check form-check-custom form-check-solid form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsAvailableForRental" />
                        <label class="form-check-label fs-6 fw-bold text-gray-700 ms-3" asp-for="IsAvailableForRental"></label>
                    </div>
                </div>
            </div>

            @* --- Row 5: Description --- *@
            <div class="fv-row mb-8">
                <label asp-for="Description" class="form-label fs-6 fw-bold text-gray-700 mb-2">Description</label>
                <textarea asp-for="Description" class="form-control form-control-solid" rows="4" placeholder="Write a brief summary about the book..."></textarea>
                <span asp-validation-for="Description" class="text-danger d-block mt-1"></span>
            </div>

            @* --- Form Action Buttons --- *@
            <div class="d-flex justify-content-end p-5">
                <a href="/Books" class="btn btn-light me-3">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <span class="indicator-label">Save Changes</span>

                    <span class="indicator-progress">
                        Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}