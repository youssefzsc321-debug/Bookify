@model UserVM

<tr class="align-middle @(Model.IsLocked?"table-danger-row":string.Empty)" >

    <td>@Model.FullName</td>
    <td>@Model.UserName</td>
    <td>@Model.Email</td>
    <td>@Model.CreatedOn</td>
    <td class="js-updated-on">@Model.LastUpdatedOn</td>
    <td>
        <span class="badge badge-light-@(Model.IsDeleted ? "danger" : "success") js-status">
            @(Model.IsDeleted ? "Deleted" : "Available")
        </span>
    </td>
    <td>
        <a href="javascript:;"
           class="btn btn-sm btn-icon btn-light btn-active-light-primary"
           data-kt-menu-trigger="click"
           data-kt-menu-placement="bottom-end"
           style="width: 32px; height: 32px;">
            <i class="bi bi-three-dots fs-4 text-gray-500"></i>
        </a>

        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded
            menu-gray-800 menu-state-bg-light-primary fw-semibold
            w-200px py-3"
             data-kt-menu="true">

            <div class="menu-item px-3">
                <a href="javascript:;"
                   class="menu-link px-3 js-render-model"
                   data-title="Edit User"
                   data-url="/User/Edit/@Model.Id"
                   data-update="true">
                    <span class="menu-icon">
                        <i class="bi bi-pencil-square"></i>
                    </span>
                    Edit
                </a>
            </div>

            <div class="menu-item px-3">
                <a href="javascript:;"
                   class="menu-link px-3 js-toggle-status"
                   data-url="/User/ToggleStatus/@Model.Id">
                    <span class="menu-icon">
                        <i class="bi bi-arrow-repeat"></i>
                    </span>
                    Toggle Status
                </a>
            </div>
            
            <div class="menu-item px-3">
                <a href="javascript:;"
                   class="menu-link px-3 js-render-model"
                   data-title="Edit Author"
                   data-url="/User/ResetPassword/@Model.Id"
                   data-update="true">
                    <span class="menu-icon">
                        <i class="bi bi-key-fill"></i>
                    </span>
                    Reset Password
                </a>
            </div>

            
            <div class="menu-item px-3">
                <a href="javascript:;"
                   class="menu-link px-3 js-lock-model"
                   data-title="UnLock User"
                   data-url="/User/UnLock/@Model.Id"
                   data-update="true">
                    <span class="menu-icon">
                        <i class="bi bi-key-fill"></i>
                    </span>
                    UnLock
                </a>
            </div>


        </div>
    </td>
</tr>