@model UserFormVM

<form id="ModalForm"
      asp-controller="User"
      asp-action="@(!string.IsNullOrEmpty(Model?.Id) ? "Edit" : "Create")"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-begin="OnModalBegin"
      data-ajax-success="OnModalSuccess"
      data-ajax-failure="showErrorMessage"
      data-ajax-complete="OnModalComplete">

    @if (!string.IsNullOrEmpty(Model?.Id))
    {
        <input type="hidden" asp-for="Id">
    }

    <div class="row g-5">

        <div class="col-12">
            <div class="form-floating">
                <input type="text" class="form-control form-control-solid" asp-for="FullName" placeholder="Full Name" />
                <label asp-for="FullName"></label>
            </div>
            <span asp-validation-for="FullName" class="text-danger d-block mt-1 fs-7"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating">
                <input type="text" class="form-control form-control-solid" asp-for="UserName" placeholder="Username" />
                <label asp-for="UserName"></label>
            </div>
            <span asp-validation-for="UserName" class="text-danger d-block mt-1 fs-7"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating">
                <input type="email" class="form-control form-control-solid" asp-for="Email" placeholder="Email Address" />
                <label asp-for="Email"></label>
            </div>
            <span asp-validation-for="Email" class="text-danger d-block mt-1 fs-7"></span>
        </div>
        @if (string.IsNullOrEmpty(Model.Id))
        {
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="password" class="form-control form-control-solid" asp-for="Password" placeholder="Password" />
                    <label asp-for="Password"></label>
                </div>
                <span asp-validation-for="Password" class="text-danger d-block mt-1 fs-7"></span>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input type="password" class="form-control form-control-solid" asp-for="ConfirmPassword" placeholder="Confirm Password" />
                    <label asp-for="ConfirmPassword"></label>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger d-block mt-1 fs-7"></span>
            </div>

        }

        <div class="col-12">
            <div class="d-flex flex-column">
                <label asp-for="SelectedRoles" class="fs-6 fw-semibold mb-2">Roles</label>
                <select asp-for="SelectedRoles" asp-items="Model.Roles" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="Select roles" multiple="multiple">
                </select>
            </div>
            <span asp-validation-for="SelectedRoles" class="text-danger d-block mt-1 fs-7"></span>
        </div>

    </div>
</form>