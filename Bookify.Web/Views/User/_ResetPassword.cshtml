@model ResetPasswordVM

<form id="ModalForm"
      asp-controller="User"
      asp-action="ResetPassword"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-begin="OnModalBegin"
      data-ajax-success="OnModalSuccess"
      data-ajax-failure="showErrorMessage"
      data-ajax-complete="OnModalComplete">

    @Html.AntiForgeryToken()

    <div class="row g-5">

       

        <!-- New Password -->
        <div class="col-md-6">
            <div class="form-floating">
                <input type="password" class="form-control form-control-solid" asp-for="NewPassword" placeholder="New Password" />
                <label asp-for="NewPassword"></label>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger d-block mt-1 fs-7"></span>
        </div>

        <!-- Confirm Password -->
        <div class="col-md-6">
            <div class="form-floating">
                <input type="password" class="form-control form-control-solid" asp-for="ConfirmPassword" placeholder="Confirm Password" />
                <label asp-for="ConfirmPassword"></label>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger d-block mt-1 fs-7"></span>
        </div>

    </div>
</form>