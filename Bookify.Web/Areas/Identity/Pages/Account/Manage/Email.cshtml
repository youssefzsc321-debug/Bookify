@page
@model EmailModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3>@ViewData["Title"]</h3>

<div class="card">
    <div class="card-body">
        <partial name="_StatusMessage" for="StatusMessage" />
        <div class="row flex-column-reverse flex-md-row">
            <div class="col-md-6 mt-10">
                <form id="email-form" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-5" role="alert"></div>

                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="fv-row mb-5">
                            <label asp-for="Email" class="form-label"></label>
                            <div class="position-relative">
                                <input asp-for="Email" class="form-control form-control-solid pe-12" placeholder="Please enter your email." disabled />
                                <span class="position-absolute top-50 end-0 translate-middle-y me-4 text-success fw-bold">
                                    <i class="bi bi-check-circle-fill text-success fs-3"></i>
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="fv-row mb-5">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control form-control-solid mb-2" placeholder="Please enter your email." disabled />
                            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link p-0 fw-semibold fs-7">Send verification email</button>
                        </div>
                    }

                    <div class="fv-row mb-5">
                        <label asp-for="Input.NewEmail" class="form-label"></label>
                        <input asp-for="Input.NewEmail" class="form-control form-control-lg form-control-solid" autocomplete="email" aria-required="true" placeholder="Enter new email" />
                        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                    </div>

                    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-lg btn-primary mt-3">Change email</button>
                </form>
            </div>
            <div class="col-md-5 offset-md-1 d-flex align-items-center justify-content-center">
                <img src="~/assets/images/mail-sent.svg" class="mw-100 mh-300px" alt="Manage Email" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}